  <graph edgedefault="undirected">
    <node id="Jellybean">
      <data key="d0">Jellybean</data>
      <data key="d1">organization</data>
      <data key="d2">Jellybean is an internal parental control system featuring notifications regarding minor access attempts to restricted materials.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Florida, US">
      <data key="d0">Florida, US</data>
      <data key="d1">geo</data>
      <data key="d2">Florida is the state where specific regulations regarding age verification and parental notifications are applicable for material deemed harmful to minors.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Florida Age Verification for Material Harmful to Minors">
      <data key="d0">Florida Age Verification for Material Harmful to Minors</data>
      <data key="d1">regulation</data>
      <data key="d2">This regulation mandates age verification procedures to prevent access by individuals under 18 years to certain materials, necessitating both anonymous and standard verification methods.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Florida Social Media Use for Minors - Platform Characteristics">
      <data key="d0">Florida Social Media Use for Minors - Platform Characteristics</data>
      <data key="d1">regulation</data>
      <data key="d2">This regulation outlines requirements for social media platforms regarding algorithms that analyze user data for content selection and notification practices.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Section 501.1737">
      <data key="d0">Section 501.1737</data>
      <data key="d1">category</data>
      <data key="d2">Section 501.1737 of the Florida Statutes addresses the age verification requirements for protecting minors from harmful materials.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Section 501.1736">
      <data key="d0">Section 501.1736</data>
      <data key="d1">category</data>
      <data key="d2">Section 501.1736 of the Florida Statutes focuses on restrictions related to algorithmic content selection and push notifications for minors.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Section 501.1738">
      <data key="d0">Section 501.1738</data>
      <data key="d1">category</data>
      <data key="d2">Section 501.1738 is referenced in the context of compliance requirements for age verification related to material harmful to minors.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Behavioral Anomaly Detection">
      <data key="d0">Behavioral Anomaly Detection</data>
      <data key="d1">category</data>
      <data key="d2">Behavioral anomaly detection refers to the method used within the parental notification system to monitor and act upon unusual access attempts by minors.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Internal Monitoring Trigger (IMT)">
      <data key="d0">Internal Monitoring Trigger (IMT)</data>
      <data key="d1">category</data>
      <data key="d2">IMT is a model used in the system for detecting anomalous behavior in user access, contrasting with standard user behavior to identify potential issues.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Baseline Behavior (BB)">
      <data key="d0">Baseline Behavior (BB)</data>
      <data key="d1">category</data>
      <data key="d2">Baseline Behavior serves as a standard for user behavior against which anomalous activities are measured in the parental notification system.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="ShadowMode">
      <data key="d0">ShadowMode</data>
      <data key="d1">category</data>
      <data key="d2">ShadowMode represents a feature that allows the parental notification system to gather analytics without impacting user experience.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Compliance Detection System (CDS)">
      <data key="d0">Compliance Detection System (CDS)</data>
      <data key="d1">category</data>
      <data key="d2">CDS is a mechanism in the system designed to log compliance-related activities and ensure adherence to regulatory requirements.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Geo-Flags">
      <data key="d0">Geo-Flags</data>
      <data key="d1">category</data>
      <data key="d2">Geo-Flags are indicators used in the system to trigger alerts based on compliance with geographical laws and regulations.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570051</data>
    </node>
    <node id="Glow">
      <data key="d0">Glow</data>
      <data key="d1">category</data>
      <data key="d2">Glow is a compliance-flagging status used internally to signal geo-based alerts within the parental notification system.</data>
      <data key="d3">chunk-b863a770e3e09f63a61ec948466e1eee</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756570052</data>
    </node>
