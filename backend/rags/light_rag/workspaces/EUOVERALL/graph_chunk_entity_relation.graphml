    <node id="Art. 4(5)">
      <data key="d0">Art. 4(5)</data>
      <data key="d1">category</data>
      <data key="d2">Art. 4(5) defines 'Pseudonymisation' within the context of data protection regulations, clarifying strategies to protect personal data.</data>
      <data key="d3">chunk-affbd5dbcf34ebe169fa07a29874fc52</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582247</data>
