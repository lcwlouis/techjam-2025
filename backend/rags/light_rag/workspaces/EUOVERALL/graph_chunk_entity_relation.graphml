  <graph edgedefault="undirected">
    <node id="Video Reply Functionality">
      <data key="d0">Video Reply Functionality</data>
      <data key="d1">event</data>
      <data key="d2">The video reply functionality is a feature being trialed specifically for users in the EEA, focusing on user-generated video content and analytics.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="EEA">
      <data key="d0">EEA</data>
      <data key="d1">geo</data>
      <data key="d2">The EEA (European Economic Area) is the region where the video reply functionality will be rolled out, encompassing multiple European countries.&lt;SEP&gt;The European Economic Area (EEA) encompasses EU countries and allows for the implementation of region-specific functionalities and regulations.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582597</data>
    </node>
    <node id="Digital Services Act (Regulation (EU) 2022/2065)">
      <data key="d0">Digital Services Act (Regulation (EU) 2022/2065)</data>
      <data key="d1">regulation</data>
      <data key="d2">The Digital Services Act is a legislative framework that imposes obligations on hosting service providers operating within the EU/EEA, particularly regarding the management of user-generated content.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="General Data Protection Regulation (GDPR)">
      <data key="d0">General Data Protection Regulation (GDPR)</data>
      <data key="d1">regulation</data>
      <data key="d2">The GDPR is a regulation governing data protection and privacy in the European Union and the European Economic Area, implementing strict rules on processing personal data.&lt;SEP&gt;The GDPR mandates principles governing data protection and privacy for individuals within the EU, applicable during the trial. </data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582597</data>
    </node>
    <node id="Geo-handler (GH)">
      <data key="d0">Geo-handler (GH)</data>
      <data key="d1">organization</data>
      <data key="d2">The Geo-handler is a module responsible for routing features based on user region, particularly in ensuring EEA-specific exposure allocation.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="Baseline Behavior (BB)">
      <data key="d0">Baseline Behavior (BB)</data>
      <data key="d1">organization</data>
      <data key="d2">Baseline Behavior refers to the standard user behavior utilized for anomaly detection in relation to video replies.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="Digital Services Act">
      <data key="d0">Digital Services Act</data>
      <data key="d1">regulation</data>
      <data key="d2">The Digital Services Act is a specific regulation within the EU that imposes obligations on hosting service providers, including rules related to transparency, user redress, and risk assessments.&lt;SEP&gt;The Digital Services Act outlines obligations for online platforms regarding content moderation, transparency, and user protection in the EU.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582597</data>
    </node>
    <node id="Articles 14–16">
      <data key="d0">Articles 14–16</data>
      <data key="d1">regulation</data>
      <data key="d2">Articles 14–16 of the Digital Services Act outline obligations for hosting service providers to manage illegal content and implement notice-and-action mechanisms.&lt;SEP&gt;Articles 14–16 of the Digital Services Act stipulate the obligations for hosting services regarding notice-and-action mechanisms for illegal content.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="Article 15 / Article 24">
      <data key="d0">Article 15 / Article 24</data>
      <data key="d1">regulation</data>
      <data key="d2">Article 15 includes transparency reporting obligations for providers of intermediary services as stated in the Digital Services Act.&lt;SEP&gt;Article 15 outlines transparency reporting obligations, while Article 24 addresses related content moderation responsibilities under the Digital Services Act.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="Article 20">
      <data key="d0">Article 20</data>
      <data key="d1">regulation</data>
      <data key="d2">Article 20 mandates the creation of an internal complaint-handling system for users to challenge content moderation decisions.&lt;SEP&gt;Article 20 of the Digital Services Act pertains to internal complaint-handling systems for users to challenge content moderation decisions.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="Article 27">
      <data key="d0">Article 27</data>
      <data key="d1">regulation</data>
      <data key="d2">Article 27 addresses transparency obligations regarding recommender systems and the documentation needed for algorithmic decision-making.&lt;SEP&gt;Article 27 requires transparency concerning the parameters used in recommender systems to moderate content.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="Articles 33–37">
      <data key="d0">Articles 33–37</data>
      <data key="d1">regulation</data>
      <data key="d2">Articles 33–37 establish the designation threshold and obligations for Very Large Online Platforms (VLOPs) under the Digital Services Act.&lt;SEP&gt;Articles 33–37 outline the obligations for very large online platforms, including risk assessments and audits.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc&lt;SEP&gt;chunk-a7af9efd9e1ca7900a1c92ce052255e7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="SCCs">
      <data key="d0">SCCs</data>
      <data key="d1">category</data>
      <data key="d2">SCCs (Standard Contractual Clauses) are contractual provisions used to ensure compliance with data protection requirements for cross-border data transfers.</data>
      <data key="d3">chunk-c16922036754e01bfff65655734f9cfc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="GDPR">
      <data key="d0">GDPR</data>
      <data key="d1">organization</data>
      <data key="d2">GDPR is a regulation in EU law on data protection and privacy, applicable to individuals within the European Union and the European Economic Area.&lt;SEP&gt;GDPR is a regulation that governs the protection of personal data and privacy in the European Union.</data>
      <data key="d3">chunk-056ac303c97fb8156cbad15ed2fbe410&lt;SEP&gt;chunk-affbd5dbcf34ebe169fa07a29874fc52</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582598</data>
    </node>
    <node id="DSA">
      <data key="d0">DSA</data>
      <data key="d1">organization</data>
      <data key="d2">The Digital Services Act (DSA) builds on prior recommendations regarding illegal online content and includes frameworks for enforcement and compliance.</data>
      <data key="d3">chunk-affbd5dbcf34ebe169fa07a29874fc52</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756582246</data>
    </node>
    <node id="Commission Recommendation">
      <data key="d0">Commission Recommendation</data>
      <data key="d1">organization</data>
      <data key="d2">Commission Recommendation pertains to prior guidelines and frameworks regarding content regulation and impacts the DSA's implementation.</data>
      <data key="d3">chunk-affbd5dbcf34ebe169fa07a29874fc52</data>
