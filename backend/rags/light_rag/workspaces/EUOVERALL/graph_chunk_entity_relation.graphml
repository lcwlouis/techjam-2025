    <node id="Art. 6(1)(f)">
      <data key="d0">Art. 6(1)(f)</data>
      <data key="d1">category</data>
      <data key="d2">Art. 6(1)(f) allows for lawful processing on the basis of legitimate interests.</data>
      <data key="d3">chunk-affbd5dbcf34ebe169fa07a29874fc52</data>
