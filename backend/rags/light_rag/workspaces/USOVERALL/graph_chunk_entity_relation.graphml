      <data key="d5">1756583447</data>
    </node>
    <node id="Redline Alert">
      <data key="d0">Redline Alert</data>
      <data key="d1">category</data>
      <data key="d2">Redline alerts are flags generated for legal review when sharing is attempted after content has been detected to possibly violate NSP policies.</data>
      <data key="d3">chunk-e0da0c71de54e74c0ac0187f2a193d2a</data>
      <data key="d4">unknown_source</data>
