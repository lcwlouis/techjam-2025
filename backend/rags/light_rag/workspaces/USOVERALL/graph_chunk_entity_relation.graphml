    </node>
    <node id="Geo-handler (GH)">
      <data key="d0">Geo-handler (GH)</data>
      <data key="d1">organization</data>
      <data key="d2">Geo-handler (GH) is a module responsible for routing features based on user regions to ensure compliance with varying regulations.</data>
      <data key="d3">chunk-bddbca1d37abd901742b0ca6610124c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756568582</data>
    </node>
    <node id="ShadowMode">
      <data key="d0">ShadowMode</data>
      <data key="d1">organization</data>
      <data key="d2">ShadowMode is a feature that allows for analytics collection in a non-user-impacting manner to gather usage metrics.</data>
      <data key="d3">chunk-bddbca1d37abd901742b0ca6610124c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1756568582</data>
    </node>
    <node id="NCMEC">
      <data key="d0">NCMEC</data>
      <data key="d1">organization</data>
      <data key="d2">The National Center for Missing &amp; Exploited Children (NCMEC) is responsible for receiving reports of child sexual abuse content as mandated by law.</data>
      <data key="d3">chunk-bddbca1d37abd901742b0ca6610124c1</data>
