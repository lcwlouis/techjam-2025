    <node id="Penalties for Failure to Report">
      <data key="d0">Penalties for Failure to Report</data>
      <data key="d1">category</data>
      <data key="d2">Penalties for Failure to Report highlights the legal consequences for providers that do not report incidents of child sexual abuse content as required by law.</data>
