    </node>
    <node id="Civil Penalties">
      <data key="d0">Civil Penalties</data>
      <data key="d1">category</data>
      <data key="d2">Civil Penalties are the consequences imposed for knowing and willful failures to report child sexual abuse materials as stipulated by 18 U.S.C. §2258A.</data>
      <data key="d3">chunk-e0da0c71de54e74c0ac0187f2a193d2a</data>
