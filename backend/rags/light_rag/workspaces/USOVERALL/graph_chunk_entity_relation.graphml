    <node id="Chat UI Overhaul">
      <data key="d0">Chat UI Overhaul</data>
      <data key="d1">event</data>
      <data key="d2">The Chat UI Overhaul refers to a newly tested chat layout aimed at improving user experience in specific regions.</data>
      <data key="d3">chunk-bddbca1d37abd901742b0ca6610124c1</data>
      <data key="d4">unknown_source</data>
