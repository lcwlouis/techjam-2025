    <node id="Child Sexual Abuse Content">
      <data key="d0">Child Sexual Abuse Content</data>
      <data key="d1">category</data>
      <data key="d2">Child Sexual Abuse Content refers to any material that depicts or suggests sexual exploitation of minors, and is subject to mandatory reporting laws.&lt;SEP&gt;Child Sexual Abuse Content refers to illegal materials that exploit or abuse minors, which providers are mandated to report under US law.</data>
      <data key="d3">chunk-03af3b99beed5a891fbf02b542aed03e&lt;SEP&gt;chunk-bddbca1d37abd901742b0ca6610124c1</data>
